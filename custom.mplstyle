# custom.mplstyle

# Figure settings
figure.figsize : 8, 6
figure.facecolor : ffffff
figure.dpi : 200

# Line settings
lines.linewidth : 2.5
lines.markersize : 6

# Font settings
font.family : sans-serif
font.size : 18.0

# Axes settings
axes.grid : False
axes.facecolor : ffffff
axes.edgecolor : 000000
axes.prop_cycle : cycler('color', ['0066ff', 'ff6600', '2a9d8f', 'f4a261'])
axes.linewidth : 2.0

# Tick marks
xtick.major.width : 2.0
ytick.major.width : 2.0

# Grid settings
grid.color : e0e0e0
grid.linestyle : --
grid.linewidth : 0.8
